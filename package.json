{
  "name": "folio-pdf-reader",
  "private": true,
  "version": "1.11.0",
  "productName": "Folio",
  "description": "A simple, clean PDF reader for Windows, macOS, and Linux",
  "homepage": "https://github.com/tsiqueira81/Folio",
  "license": "MIT",
  "author": "Forward Future",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@types/express": "^5.0.6",
    "dotenv": "^18.0.10",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "katex": "^0.19.1",
    "mdast-util-from-markdown": "^2.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-math": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "app.folio.reader",
    "productName": "Folio",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/*.zip",
      "!dist/*.exe",
      "!dist/assets/aistudio/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/mammoth/mammoth.browser*.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio",
      "artifactName": "Folio-Setup.exe"
    },
    "portable": {
      "artifactName": "Folio-Portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "Folio-mac.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "tsiqueira81 <tsiqueira81@users.noreply.github.com>"
    },
    "deb": {
      "artifactName": "Folio-linux-amd64.deb"
    },
    "appImage": {
      "artifactName": "Folio-linux-x86_64.AppImage"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer",
        "icon": "build/icon.png"
      }
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "dist/.vite/license.md",
        "to": "licenses/THIRD_PARTY_LICENSES.md"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "overrides": {
    "katex": "$katex"
  }
}
